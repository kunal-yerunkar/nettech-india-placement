# MongoDB Atlas Connection String
# Generate at https://www.mongodb.com/cloud/atlas
# Format: mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your-username:your-password@your-cluster.mongodb.net/?retryWrites=true&w=majority

# Generate a secure JWT secret: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-recommended

# Server port
PORT=5000

# Frontend origin for CORS
CLIENT_ORIGIN=http://localhost:5173

# Optional: Set to 'true' to reset database (development only)
# RESET_DB=false
# RESET_CONFIRM=

# Optional: Bootstrap default admin on startup
# BOOTSTRAP_ADMIN_USER=admin
# BOOTSTRAP_ADMIN_PASS=admin123

# Environment
NODE_ENV=development